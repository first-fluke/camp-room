# Server-only data-provider credentials. Keep actual .env out of version control.
CAMP_DATA_MODE=demo
# auto: live when configured, explicitly labelled demo fallback on failure.
# live: no fixture fallback; unavailable data stays unavailable.
GOCAMPING_SERVICE_KEY=
KMA_API_HUB_KEY=
# Optional data.go.kr alternative to API Hub:
KMA_SERVICE_KEY=
# Optional absolute SQLite path; default apps/api/data/camp-room.sqlite3
# CAMP_DB_PATH=
# Android backend address is set with Gradle -PcampApiBaseUrl=https://HOST/api/v1

# Persistent database: Turso is used when configured.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CAMP_DB_NAMESPACE=camp-room
# An explicit CAMP_DB_PATH selects isolated local SQLite for tests/demo.

# Server-only administrator access. Set strong values in the actual .env.
CAMP_ADMIN_TOKEN=
CAMP_ADMIN_PASSWORD=
CAMP_ADMIN_SESSION_SECRET=
